# ══════════════════════════════════════════
# VARIABLES D'ENVIRONNEMENT — KIVU CULTURE HUB API
# ══════════════════════════════════════════
# Copie ce fichier en ".env" en LOCAL uniquement (jamais sur Git).
# Sur Render, ces mêmes variables se configurent dans
# Dashboard > ton service > Environment > Environment Variables.

# Port du serveur (Render fournit automatiquement sa propre variable PORT,
# donc cette valeur ne sert qu'en local)
PORT=4000

# Origine(s) autorisée(s) pour CORS — l'URL de ton frontend Firebase Hosting
# Plusieurs origines séparées par une virgule sont acceptées.
FRONTEND_ORIGIN=https://kivu-culture-hub-78805.web.app

# Secret utilisé pour signer les JWT — génère une longue chaîne aléatoire,
# par exemple avec: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=remplace_moi_par_une_chaine_aleatoire_longue

# Durée de validité des tokens JWT
JWT_EXPIRES_IN=7d

# ── Identifiants Firebase Admin SDK ──
# Va sur: Firebase Console > Paramètres du projet > Comptes de service
# > Générer une nouvelle clé privée. Cela télécharge un fichier JSON.
# Ouvre ce fichier et copie chaque valeur ci-dessous (PAS le fichier entier).
FIREBASE_PROJECT_ID=kivu-culture-hub-78805
FIREBASE_CLIENT_EMAIL=xxxx@kivu-culture-hub-78805.iam.gserviceaccount.com
# Important : la clé privée contient des "\n" littéraux — garde les guillemets
# et ne les remplace pas par de vrais retours à la ligne dans le .env
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXXXXXX\n-----END PRIVATE KEY-----\n"
